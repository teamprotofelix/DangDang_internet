# ============================================================
# .gitignore — 깃허브에 올리지 않을 파일
# ============================================================

# 작업 영속성 폴더 (참고 자료, 보안 점검 결과, 개인 자료 등)
.작업영속성/

# OS / 편집기 잡파일
.DS_Store
Thumbs.db
desktop.ini
*.log
node_modules/

# 로컬 임시 산출물
# (주의: '_'로 시작하는 파일명은 Chrome 확장 로드 불가 — 테스트 페이지는 '_' 없이 명명)

# Local implementation and browser scratch files
work/

# Generated local PDF.js assets
vendor/pdfjs/
